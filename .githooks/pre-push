#!/usr/bin/env bash
# 무료 플랜 private 저장소는 GitHub 브랜치 보호 규칙을 쓸 수 없다
# (ruleset API 가 HTTP 403 "Upgrade to GitHub Pro"). 그 대체 수단이다.
#
#   1. main 직접 푸시 차단 → 반드시 feature 브랜치 + PR
#   2. 버전 태그(v*.*.*) 푸시 차단 → 첫 정식 릴리스(Task 21)에서만 허용
#
# Task 21 에서 의도적으로 태그를 푸시할 때만 아래로 우회한다.
#   SOOLJANG_ALLOW_TAG_PUSH=1 git push origin v1.0.0

set -euo pipefail

while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [[ "$remote_ref" == "refs/heads/main" ]]; then
        echo "main 브랜치 직접 푸시는 차단되어 있습니다." >&2
        echo "feature 브랜치를 푸시하고 PR 을 생성하세요." >&2
        exit 1
    fi

    if [[ "$remote_ref" =~ ^refs/tags/v[0-9]+\.[0-9]+\.[0-9]+ ]]; then
        if [[ "${SOOLJANG_ALLOW_TAG_PUSH:-}" != "1" ]]; then
            echo "버전 태그 푸시는 차단되어 있습니다: ${remote_ref#refs/tags/}" >&2
            echo "릴리스는 모든 기능 Task 완료 후 Task 21 에서 한 번만 수행합니다." >&2
            echo "의도한 릴리스라면 SOOLJANG_ALLOW_TAG_PUSH=1 을 지정하세요." >&2
            exit 1
        fi
    fi
done
