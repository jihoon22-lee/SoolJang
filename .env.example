# 이 파일을 `.env` 로 복사해 값을 채운다. `.env` 는 커밋되지 않는다.
# 실제 시크릿 값을 이 파일에 적지 않는다.

# ---------------------------------------------------------------------------
# 애플리케이션
# ---------------------------------------------------------------------------
SOOLJANG_ENVIRONMENT=local
SOOLJANG_DEBUG=false

# 로컬 개발용. `make db-start` 가 띄우는 사용자 영역 PostgreSQL 을 가리킨다.
SOOLJANG_DATABASE_URL=postgresql+psycopg://sooljang@127.0.0.1:54329/sooljang_dev
SOOLJANG_DATABASE_POOL_SIZE=5
SOOLJANG_DATABASE_ECHO=false

SOOLJANG_API_HOST=127.0.0.1
SOOLJANG_API_PORT=8000

# Vite 개발 서버에서 API 를 호출할 때만 필요하다. 운영은 단일 프록시라 비워 둔다.
SOOLJANG_CORS_ORIGINS=http://localhost:5173

# LLM API 키(설정 화면에서 입력)를 DB 에 암호화해 저장하는 Fernet 마스터 키(Task 17).
# 필수. 아래 명령으로 생성한다:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOOLJANG_SECRET_KEY=

# ---------------------------------------------------------------------------
# Docker Compose (운영)
# ---------------------------------------------------------------------------
POSTGRES_USER=sooljang
POSTGRES_DB=sooljang
# 필수. 값을 비우면 compose 가 기동을 거부한다.
POSTGRES_PASSWORD=
SOOLJANG_VERSION=local

# ---------------------------------------------------------------------------
# 외부 서비스 (Task 18 에서 사용. 이름만 문서화하고 값은 비워 둔다)
# ---------------------------------------------------------------------------
# SOOLJANG_SEARCH_API_KEY=

# LLM 제공자·API 키는 더 이상 환경 변수로 넣지 않는다(Task 17) — 로그인 후 "설정" 화면에서
# 입력하면 DB 에 암호화되어 저장된다. 이 위 SOOLJANG_SECRET_KEY 만 한 번 설정하면 된다.
